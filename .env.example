# Copy to `.env` and fill in the keys you have:  cp .env.example .env
# `.env` is gitignored; the repo-fix CLI loads it automatically (real env vars take precedence).

# Teacher (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Student model served by Fireworks (OpenAI-compatible API): https://app.fireworks.ai/settings/users/api-keys
# The model and endpoint are set in configs/models.yaml (student.serving).
FIREWORKS_API_KEY=

# Optional: GPT teacher candidate
# OPENAI_API_KEY=

# Optional: Voyage embeddings for retrieval / semantic dedup (--embedder voyage:voyage-code-3)
# VOYAGE_API_KEY=

# Optional: GitHub token for `repo-fix serve` (private clones, PRs). If unset, `gh auth token` is used.
# GITHUB_TOKEN=

# LLM request/response cache (avoids paying twice for the same call). See src/repo_fix_agent/llm_cache.py
# REPOFIX_LLM_CACHE=on
# REPOFIX_LLM_CACHE_PATH=.cache/llm/llm_cache.sqlite

# Sandbox: auto | docker | local, and the docker image (docker/sandbox.Dockerfile)
# REPOFIX_SANDBOX=auto
# REPOFIX_SANDBOX_IMAGE=repo-fix-sandbox:py3.12
